--- a/aidl/thermal/Thermal.cpp
+++ b/aidl/thermal/Thermal.cpp
@@ -183,7 +183,8 @@ ndk::ScopedAStatus Thermal::registerThermalChangedCallback(
             std::lock_guard<std::mutex> _lock(thermal_callback_mutex_);
             auto it = std::find_if(callbacks_.begin(), callbacks_.end(),
                                    [&](const CallbackSetting &cc) {
-                                       return interfacesEqual(c.callback, cc.callback);
+                                       return interfacesEqual(c.callback, cc.callback) &&
+                                              c.registration_token == cc.registration_token;
                                    });
             if (it != callbacks_.end()) {
                 if (AIBinder_isAlive(c.callback->asBinder().get())) {
diff --git a/aidl/thermal/Thermal.h b/aidl/thermal/Thermal.h
index d77d9b336580711af0d2b77632f594f94bb825ce..53014134fcc110299de0b056001cb1912fbf3ef0 100644
--- a/aidl/thermal/Thermal.h
+++ b/aidl/thermal/Thermal.h
@@ -8,6 +8,7 @@
 
 #include <aidl/android/hardware/thermal/BnThermal.h>
 
+#include <memory>
 #include <mutex>
 #include <thread>
 
@@ -26,6 +27,8 @@ struct CallbackSetting {
     std::shared_ptr<IThermalChangedCallback> callback;
     bool is_filter_type;
     TemperatureType type;
+    // Distinguish queued notifications from later registrations of the same callback.
+    std::shared_ptr<const char> registration_token = std::make_shared<const char>(0);
 };
 
