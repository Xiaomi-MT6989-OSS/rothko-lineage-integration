From affc75f1b72e26c55aa9fce1b0e5fd13ae13afda Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Wed, 28 Oct 2026 21:02:10 +0800
Subject: [PATCH 1/5] thermal: reject malformed and non-finite physical
 readings

atof accepts partial strings and turns invalid text into zero, which can clear a previously hot severity. Parse the complete trimmed input and reject non-finite values before updating the cached temperature or severity. Preserve valid readings and the existing kernel sentinel conversion.
---
 aidl/thermal/thermal-helper.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/aidl/thermal/thermal-helper.cpp b/aidl/thermal/thermal-helper.cpp
index 7f5874ae05f3b5fc1fd95d4acec73ad0e79509a3..f5f2d77baad356d24c415cb3641247376c26c3d8 100644
--- a/aidl/thermal/thermal-helper.cpp
+++ b/aidl/thermal/thermal-helper.cpp
@@ -9,6 +9,7 @@
 
 #include <android-base/file.h>
 #include <android-base/logging.h>
+#include <android-base/parsedouble.h>
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
 #include <android-base/strings.h>
@@ -1485,7 +1486,13 @@ SensorReadStatus ThermalHelperImpl::readThermalSensor(
             LOG(ERROR) << "failed to read sensor: " << sensor_name << " zone: " << sensor_info.zone_name;
             return SensorReadStatus::ERROR;
         }
-        *temp = std::atof(::android::base::Trim(file_reading).c_str());
+        float reading;
+        if (!::android::base::ParseFloat(::android::base::Trim(file_reading), &reading) ||
+            !std::isfinite(reading)) {
+            LOG(ERROR) << "Invalid temperature reading for sensor: " << sensor_name;
+            return SensorReadStatus::ERROR;
+        }
+        *temp = reading;
     } else {
         const auto &linked_sensors_size = sensor_info.virtual_sensor_info->linked_sensors.size();
         std::vector<bool> count_threshold_counted(linked_sensors_size, false);

From 59892c14bb3148fec42ae97b1db8418f73b8e817 Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Wed, 28 Oct 2026 21:08:04 +0800
Subject: [PATCH 2/5] thermal: retain polling after unsuccessful sensor reads

Failed or collecting reads skipped the next-timeout vote. If every monitored read was unsuccessful, the watcher returned milliseconds::max(), leaving polling dependent on an external event. Vote the existing minimum polling interval on unsuccessful reads without changing successful sampling or temperature policy.
---
 aidl/thermal/thermal-helper.cpp | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/aidl/thermal/thermal-helper.cpp b/aidl/thermal/thermal-helper.cpp
index f5f2d77baad356d24c415cb3641247376c26c3d8..c96904db2c26dd9a07b4063efde6fdc257d445d2 100644
--- a/aidl/thermal/thermal-helper.cpp
+++ b/aidl/thermal/thermal-helper.cpp
@@ -15,6 +15,7 @@
 #include <android-base/strings.h>
 #include <utils/Trace.h>
 
+#include <algorithm>
 #include <set>
 #include <sstream>
 #include <vector>
@@ -1735,6 +1736,10 @@ std::chrono::milliseconds ThermalHelperImpl::thermalWatcherCallbackFunc(
         }
 
         const auto ret = readTemperature(name_status_pair.first, &temp, force_no_cache);
+        if (ret != SensorReadStatus::OKAY) {
+            // Keep polling even if every monitored sensor failed or is still collecting.
+            min_sleep_ms = std::min(min_sleep_ms, kMinPollIntervalMs);
+        }
         if (ret == SensorReadStatus::ERROR) {
             LOG(ERROR) << __func__
                        << ": error reading temperature for sensor: " << name_status_pair.first;

From 1480fd5948145934be8c7abe413758474b8e465e Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Wed, 28 Oct 2026 21:14:44 +0800
Subject: [PATCH 3/5] thermal: scope queued snapshots to their registration
 lifetime

Unregistering and registering the same callback before a queued initial snapshot runs could deliver an old type-filtered snapshot to the new registration. Keep a unique token per registration and require it to match before delivering a queued snapshot.
---
 aidl/thermal/Thermal.cpp | 3 ++-
 aidl/thermal/Thermal.h   | 3 +++
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/aidl/thermal/Thermal.cpp b/aidl/thermal/Thermal.cpp
