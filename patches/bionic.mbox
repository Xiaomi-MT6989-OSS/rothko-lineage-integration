 libc/Android.bp | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/libc/Android.bp b/libc/Android.bp
index 73cda9a61fa2ea398f34790e2c0a6e580c7de2d2..3f81e970e3349f122174ab79fb3ade26304c0e65 100644
--- a/libc/Android.bp
+++ b/libc/Android.bp
