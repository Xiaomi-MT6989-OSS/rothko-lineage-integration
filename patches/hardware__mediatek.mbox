From 278b978cc5ffb63c5e0642b5ee46ff89ddc93216 Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Wed, 28 Oct 2026 21:17:37 +0800
Subject: [PATCH 4/5] thermal: initialize and synchronize callback queue
 shutdown

The callback Looper left aborted_ uninitialized and read it outside the mutex used by shutdown. Initialize the flag and check it only while holding the queue mutex, so a new worker does not exit from reused memory and shutdown does not race an unlocked loop condition.
---
 aidl/thermal/Thermal.cpp | 13 +++++++------
 aidl/thermal/Thermal.h   |  2 +-
 2 files changed, 8 insertions(+), 7 deletions(-)

diff --git a/aidl/thermal/Thermal.cpp b/aidl/thermal/Thermal.cpp
index b9b64cf22cc9d0cb44e4c16a74a732d65839102d..6e2457676153081e84e91b723423e84ab18aeb73 100644
--- a/aidl/thermal/Thermal.cpp
+++ b/aidl/thermal/Thermal.cpp
@@ -899,15 +899,16 @@ Thermal::Looper::~Looper() {
 }
 
 void Thermal::Looper::loop() {
-    while (!aborted_) {
+    while (true) {
         std::unique_lock<std::mutex> lock(mutex_);
         cv_.wait(lock, [&] { return aborted_ || !events_.empty(); });
-        if (!aborted_ && !events_.empty()) {
-            Event event = events_.front();
-            events_.pop();
-            lock.unlock();
-            event.handler();
+        if (aborted_) {
+            return;
         }
+        Event event = events_.front();
+        events_.pop();
+        lock.unlock();
+        event.handler();
     }
 }
 
diff --git a/aidl/thermal/Thermal.h b/aidl/thermal/Thermal.h
index 53014134fcc110299de0b056001cb1912fbf3ef0..9c49ce2dbeb1535672ada7594c49302e3030c945 100644
--- a/aidl/thermal/Thermal.h
+++ b/aidl/thermal/Thermal.h
@@ -97,8 +97,8 @@ class Thermal : public BnThermal {
         std::condition_variable cv_;
         std::queue<Event> events_;
         std::mutex mutex_;
+        bool aborted_ = false;
         std::thread thread_;
-        bool aborted_;
 
         void loop();
     };

From 43572e2342b9cb9b37f4e3d8dce44d7c8152f15b Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Wed, 28 Oct 2026 21:32:58 +0800
Subject: [PATCH 5/5] thermal: stop workers before destroying callback state

Drain the active snapshot handler before releasing the helper, and destroy the helper while subscription state is still alive. Its owner-thread destructor requests watcher exit, wakes the poll loop, and waits before releasing sensor state. Make the callback queue stop operation idempotent for explicit owner shutdown and subsequent member destruction.
---
 aidl/thermal/Thermal.cpp        | 14 +++++++++++++-
 aidl/thermal/Thermal.h          |  3 ++-
 aidl/thermal/thermal-helper.cpp |  9 +++++++++
 aidl/thermal/thermal-helper.h   |  2 +-
 4 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/aidl/thermal/Thermal.cpp b/aidl/thermal/Thermal.cpp
index 6e2457676153081e84e91b723423e84ab18aeb73..2a8276c663a99b4d6412cc813c0b6759cabaa214 100644
--- a/aidl/thermal/Thermal.cpp
+++ b/aidl/thermal/Thermal.cpp
@@ -49,6 +49,12 @@ Thermal::Thermal(const std::shared_ptr<ThermalHelper> &helper) {
     thermal_helper_ = helper;
 }
 
+Thermal::~Thermal() {
+    // Queued snapshots use the helper; watcher callbacks use the subscription state.
+    looper_.stop();
+    thermal_helper_.reset();
+}
+
 ndk::ScopedAStatus Thermal::getTemperatures(std::vector<Temperature> *_aidl_return) {
     return getFilteredTemperatures(false, TemperatureType::UNKNOWN, _aidl_return);
 }
@@ -890,12 +896,18 @@ void Thermal::Looper::addEvent(const Thermal::Looper::Event &e) {
 }
 
 Thermal::Looper::~Looper() {
+    stop();
+}
+
+void Thermal::Looper::stop() {
     {
         std::unique_lock<std::mutex> lock(mutex_);
         aborted_ = true;
     }
     cv_.notify_one();
-    thread_.join();
+    if (thread_.joinable()) {
+        thread_.join();
+    }
 }
 
 void Thermal::Looper::loop() {
diff --git a/aidl/thermal/Thermal.h b/aidl/thermal/Thermal.h
index 9c49ce2dbeb1535672ada7594c49302e3030c945..54d17215e178934fb20823f6c4cdb9971beb5e12 100644
--- a/aidl/thermal/Thermal.h
+++ b/aidl/thermal/Thermal.h
@@ -44,7 +44,7 @@ class Thermal : public BnThermal {
   public:
     Thermal();
     explicit Thermal(const std::shared_ptr<ThermalHelper> &helper);
-    ~Thermal() = default;
+    ~Thermal();
     ndk::ScopedAStatus getTemperatures(std::vector<Temperature> *_aidl_return) override;
     ndk::ScopedAStatus getTemperaturesWithType(TemperatureType type,
                                                std::vector<Temperature> *_aidl_return) override;
@@ -90,6 +90,7 @@ class Thermal : public BnThermal {
             thread_ = std::thread([&] { loop(); });
         }
         ~Looper();
+        void stop();
 
         void addEvent(const Event &e);
 
diff --git a/aidl/thermal/thermal-helper.cpp b/aidl/thermal/thermal-helper.cpp
index c96904db2c26dd9a07b4063efde6fdc257d445d2..d2fdb2d4799e19f48cff09d175fd5eb80408ec06 100644
--- a/aidl/thermal/thermal-helper.cpp
+++ b/aidl/thermal/thermal-helper.cpp
@@ -428,6 +428,15 @@ ThermalHelperImpl::ThermalHelperImpl(const NotificationCallback &cb)
     }
 }
 
+ThermalHelperImpl::~ThermalHelperImpl() {
+    if (thermal_watcher_ != nullptr) {
+        // Stop the callback on the owner thread before destroying sensor state.
+        thermal_watcher_->requestExit();
+        thermal_watcher_->wake();
+        thermal_watcher_->requestExitAndWait();
+    }
+}
