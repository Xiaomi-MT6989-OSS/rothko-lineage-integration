+    explicit NativeHandleOwner(ACameraWindowType* window) : mWindow(window) {}
+    ~NativeHandleOwner() override {
+        native_handle_delete(const_cast<native_handle_t*>(mWindow));
+    }
+    ACameraWindowType* mWindow;
+};
+#else
+using WindowHandle = ANativeWindow*;
+using OutputWindow = ::aidl::android::view::Surface;
+#endif
