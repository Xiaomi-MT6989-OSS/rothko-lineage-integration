From 7e7768bde07221df4626e7edc7741c29114b422e Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Sat, 14 Nov 2026 16:52:08 +0800
Subject: [PATCH 2/3] rothko: supply graphics enum headers to camera client
 helper

Android 17 commit 5d5aaa1a6b adds PixelFormat::RAW14 to CameraModule. The local nogralloc helper deliberately omits libui to avoid mixing graphics AIDL versions in the OEM camera client. Add the V7 generated headers and existing binder NDK dependency, keeping the V7 interface library off the link graph. This is confined to the local compatibility variant. Replayed the failed ARM64/CFI compile command with these header paths, passing with Werror. Unified Soong graph, IMG build and runtime camera validation remain pending. Provenance: hardware/interfaces graphics/Android.bp and system/tools/aidl/build/aidl_gen_rule.go GeneratedHeaderDirs.

Change-Id: Ia49ea848e9d1b53b6124a8dff592d232d8a66d77
---
 camera/common/default/Android.bp | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/camera/common/default/Android.bp b/camera/common/default/Android.bp
index edcea1c0297dc6c958e0841cf7dda7e0115baef1..72287fb97844d1d40919a1fd867f800c50468038 100644
--- a/camera/common/default/Android.bp
+++ b/camera/common/default/Android.bp
@@ -39,12 +39,14 @@ cc_library_static {
     export_shared_lib_headers: ["libui"],
 }
 
-// Client-only variant: HandleImporter (the sole user of libgralloctypes and
-// libui) is provider-side and is not needed by the NDK camera client.
+// Client-only variant: HandleImporter is provider-side and is not needed by
+// the NDK camera client. CameraModule still needs the graphics AIDL enums.
 cc_library_static {
     name: "android.hardware.camera.common-helper_nogralloc",
     vendor: true,
     defaults: ["hidl_defaults"],
+    // RAW14 is an enum only. Keep V7 off the legacy camera client's link graph.
+    generated_headers: ["android.hardware.graphics.common-V7-ndk-source"],
     srcs: [
         "CameraModule.cpp",
         "CameraMetadata.cpp",
@@ -59,6 +61,7 @@ cc_library_static {
         "-Wall",
     ],
     shared_libs: [
+        "libbinder_ndk",
         "liblog",
         "libhardware",
         "libcamera_metadata",

From b9832f79b852e161eee2ca7c050429f0a5f16d1c Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Sat, 14 Nov 2026 16:58:18 +0800
Subject: [PATCH 3/3] rothko: exclude provider-only CameraModule from NDK
 client helper

Attempt 21 proves even generated V7 enum headers propagate AIDL version checks to libmiface, which uses OEM graphics V4. Supersede 7e7768bde0 by removing CameraModule.cpp from the local client-only static variant instead of adding a graphics dependency. No CameraModule references exist under frameworks/av/camera/ndk, and all compiled client objects have no CameraModule undefined symbols. The ordinary upstream provider helper remains intact, preserving RAW14 support. Diff check passed. Soong graph, link, IMG and device face-camera acceptance remain pending. Evidence and companion pins in project LINEAGE_24_MIGRATION_20261114 record.

Change-Id: I5c999474241e522207fbecd29c19abe61d900bd0
---
 camera/common/default/Android.bp | 8 ++------
 1 file changed, 2 insertions(+), 6 deletions(-)

diff --git a/camera/common/default/Android.bp b/camera/common/default/Android.bp
index 72287fb97844d1d40919a1fd867f800c50468038..c3d8dce36daba95a36ed72846ccd7f161288b0da 100644
--- a/camera/common/default/Android.bp
+++ b/camera/common/default/Android.bp
@@ -39,16 +39,13 @@ cc_library_static {
     export_shared_lib_headers: ["libui"],
 }
 
-// Client-only variant: HandleImporter is provider-side and is not needed by
-// the NDK camera client. CameraModule still needs the graphics AIDL enums.
+// Client-only variant: CameraModule and HandleImporter are provider-side and
+// are not used by the NDK client. Keep their graphics dependencies isolated.
 cc_library_static {
     name: "android.hardware.camera.common-helper_nogralloc",
     vendor: true,
     defaults: ["hidl_defaults"],
-    // RAW14 is an enum only. Keep V7 off the legacy camera client's link graph.
-    generated_headers: ["android.hardware.graphics.common-V7-ndk-source"],
     srcs: [
-        "CameraModule.cpp",
         "CameraMetadata.cpp",
         "CameraParameters.cpp",
         "VendorTagDescriptor.cpp",
@@ -61,7 +58,6 @@ cc_library_static {
         "-Wall",
     ],
     shared_libs: [
-        "libbinder_ndk",
         "liblog",
         "libhardware",
         "libcamera_metadata",
