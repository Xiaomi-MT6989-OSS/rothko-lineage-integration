         "bionic/__cxa_pure_virtual.cpp",
         "bionic/new.cpp",
     ],
+    min_sdk_version: "33",
     static_ndk_lib: true,
     static_libs: ["libasync_safe"],
     apex_available: [
         "//apex_available:platform",
+        "com.android.bt",
     ],
 
     static: {
