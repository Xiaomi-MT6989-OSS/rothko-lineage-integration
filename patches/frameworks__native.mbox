+struct OutputUpdateColorProfileTest_CachedSdrPolicy : OutputUpdateColorProfileTest {
+    struct CachedPolicy : DisplayColorExtension {
+        DisplayColorPolicy policy{.revision = 42,
+                                  .renderIntent = static_cast<ui::RenderIntent>(257),
+                                  .wideColorGamut = false};
+        bool isEnabled() const override { return true; }
+        DisplayColorPolicy getPolicy(PhysicalDisplayId) const override {
+            return policy;
+        }
+        void onContent(PhysicalDisplayId, const DisplayColorContent& content) override {
+            observed = content;
+            // Deliberately leave the cached SDR policy intact, as happens
+            // before the asynchronous device worker processes this HDR frame.
+        }
+        void onPolicyRejected(PhysicalDisplayId, uint64_t) override { ++rejected; }
+        DisplayColorContent observed;
+        int rejected = 0;
+    } extension;
+
+    OutputUpdateColorProfileTest_CachedSdrPolicy() {
+        mOutput.colorExtensionForTest = &extension;
+        mRefreshArgs.outputColorSetting = OutputColorSetting::kManaged;
+        EXPECT_CALL(mOutput, getOutputLayerCount()).WillRepeatedly(Return(1u));
+        EXPECT_CALL(*mDisplayColorProfile,
+                    getBestColorMode(_, static_cast<ui::RenderIntent>(257), _, _, _)).Times(0);
+    }
+
+    void verifyHdrFrame(ui::Dataspace hdr, bool legacy, bool client) {
+        mLayer1.mLayerFEState.dataspace = hdr;
+        mLayer1.mLayerFEState.forceClientComposition = client;
+        EXPECT_CALL(*mDisplayColorProfile, hasLegacyHdrSupport(hdr)).WillOnce(Return(legacy));
+        const bool nativeHdr = !legacy && !client;
+        const auto dataspace = nativeHdr ? hdr : ui::Dataspace::V0_SRGB;
+        const auto intent = nativeHdr ? ui::RenderIntent::TONE_MAP_COLORIMETRIC
+                                      : ui::RenderIntent::COLORIMETRIC;
+        const auto mode = nativeHdr ? (hdr == ui::Dataspace::BT2020_HLG
+                                               ? ui::ColorMode::BT2100_HLG
+                                               : ui::ColorMode::BT2100_PQ)
+                                    : ui::ColorMode::SRGB;
+        EXPECT_CALL(*mDisplayColorProfile, getBestColorMode(dataspace, intent, _, _, _))
+                .WillOnce(DoAll(SetArgPointee<2>(dataspace), SetArgPointee<3>(mode),
+                                SetArgPointee<4>(intent)));
+        EXPECT_CALL(mOutput, setColorProfile(ColorProfileEq(ColorProfile{mode, dataspace, intent})));
+        mOutput.updateColorProfile(mRefreshArgs);
+        EXPECT_EQ(hdr, extension.observed.hdrCandidate);
+        EXPECT_EQ(dataspace, extension.observed.outputCandidate);
+        EXPECT_EQ(0, extension.rejected);
+    }
+};
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstPqFramePreservesNativeToneMapping) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, false, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstHlgFramePreservesNativeToneMapping) {
+    verifyHdrFrame(ui::Dataspace::BT2020_HLG, false, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstLegacyHdrFramePreservesUpstreamPolicy) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, true, false);
+}
+
+TEST_F(OutputUpdateColorProfileTest_CachedSdrPolicy, firstClientHdrFramePreservesUpstreamPolicy) {
+    verifyHdrFrame(ui::Dataspace::BT2020_PQ, false, true);
+}
+
+struct OutputUpdateColorProfileTest_CachedHlgPolicy
+      : OutputUpdateColorProfileTest_CachedSdrPolicy {
+    OutputUpdateColorProfileTest_CachedHlgPolicy() {
+        extension.policy = {.revision = 42,
+                            .renderIntent = static_cast<ui::RenderIntent>(275),
+                            .wideColorGamut = true,
+                            .legacyHlg = true};
+    }
+
+    void verifyPolicy(ui::Dataspace hdr, bool legacy, bool client, bool supported,
+                      bool forcedClient = false) {
+        if (forcedClient) {
+            mRefreshArgs.forcedClientCompositionLayerStacks.insert(
+                    mOutput.getState().layerFilter.layerStack);
+        }
+        const bool hlg = hdr == ui::Dataspace::BT2020_HLG ||
+                hdr == ui::Dataspace::BT2020_ITU_HLG;
+        const auto normalizedHdr = hlg ? ui::Dataspace::BT2020_HLG : hdr;
+        mLayer1.mLayerFEState.dataspace = hdr;
+        mLayer1.mLayerFEState.forceClientComposition = client;
+        EXPECT_CALL(*mDisplayColorProfile, hasLegacyHdrSupport(normalizedHdr))
+                .WillOnce(Return(legacy));
+        const bool native = !legacy && !client;
+        const auto target = native ? normalizedHdr : ui::Dataspace::DISPLAY_P3;
+        const auto normalIntent = native ? ui::RenderIntent::TONE_MAP_COLORIMETRIC
+                                         : ui::RenderIntent::COLORIMETRIC;
+        const auto mode = native ? (hlg ? ui::ColorMode::BT2100_HLG : ui::ColorMode::BT2100_PQ)
+                                 : ui::ColorMode::DISPLAY_P3;
+        EXPECT_CALL(*mDisplayColorProfile, getBestColorMode(target, normalIntent, _, _, _))
+                .WillOnce(DoAll(SetArgPointee<2>(target), SetArgPointee<3>(mode),
+                                SetArgPointee<4>(normalIntent)));
+        const bool eligible = hlg && legacy && !client && !forcedClient;
+        const auto oemIntent = static_cast<ui::RenderIntent>(275);
+        if (eligible) {
+            EXPECT_CALL(*mDisplayColorProfile, getBestColorMode(target, oemIntent, _, _, _))
+                    .WillOnce(DoAll(SetArgPointee<2>(target), SetArgPointee<3>(mode),
+                                    SetArgPointee<4>(supported ? oemIntent : normalIntent)));
+        } else {
+            EXPECT_CALL(*mDisplayColorProfile, getBestColorMode(_, oemIntent, _, _, _)).Times(0);
+        }
+        const auto expected = eligible && supported
+                ? ColorProfile{mode, target, oemIntent, 42}
+                : ColorProfile{mode, target, normalIntent};
+        EXPECT_CALL(mOutput, setColorProfile(ColorProfileEq(expected)));
+        mOutput.updateColorProfile(mRefreshArgs);
+        EXPECT_EQ(eligible && !supported ? 1 : 0, extension.rejected);
+    }
+};
+
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, legacyHlgUsesSupportedOemIntent) {
+    verifyPolicy(ui::Dataspace::BT2020_HLG, true, false, true);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, ituHlgUsesSupportedOemIntent) {
+    verifyPolicy(ui::Dataspace::BT2020_ITU_HLG, true, false, true);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, unsupportedIntentIsRejected) {
+    verifyPolicy(ui::Dataspace::BT2020_HLG, true, false, false);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, cachedHlgDoesNotOverridePq) {
+    verifyPolicy(ui::Dataspace::BT2020_PQ, true, false, true);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, cachedHlgDoesNotOverrideNativeHdr) {
+    verifyPolicy(ui::Dataspace::BT2020_HLG, false, false, true);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, cachedHlgDoesNotOverrideClientToneMapping) {
+    verifyPolicy(ui::Dataspace::BT2020_HLG, true, true, true);
+}
+TEST_F(OutputUpdateColorProfileTest_CachedHlgPolicy, cachedHlgDoesNotOverrideForcedClientStack) {
+    verifyPolicy(ui::Dataspace::BT2020_HLG, true, false, true, true);
+}
