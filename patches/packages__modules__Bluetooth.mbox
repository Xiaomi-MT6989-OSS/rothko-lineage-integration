+          static_cast<uint8_t>(bluetooth::hci::ErrorCode::UNSUPPORTED_FEATURE_OR_PARAMETER_VALUE),
+          leaudio_group_id, {});
+  SyncOnMainLoop();
+  EXPECT_FALSE(group->asymmetric_phy_for_unidirectional_cis_supported);
+}
