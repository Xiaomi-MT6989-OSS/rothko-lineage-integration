+            float oldMax = storedMax == null ? legacyMax : storedMax;
+            if (!BrightnessBacklightRange.isValid(oldMin, oldMax)) continue;
+            if (storedMin != null && storedMax != null && oldMin == min && oldMax == max) {
+                continue;
+            }
+            Float brightness = state.get(BRIGHTNESS_KEY);
+            if (brightness != null) {
+                float mapped = BrightnessBacklightRange.convert(brightness, oldMin, oldMax, min, max);
+                if (!Float.isFinite(mapped)) continue;
+                state.put(BRIGHTNESS_KEY, mapped);
+            }
+            state.put(BACKLIGHT_MIN_KEY, min);
+            state.put(BACKLIGHT_MAX_KEY, max);
+            changed = true;
+        }
+        if (changed) setDirty();
+        return changed;
+    }
