From 503cd9692f175c8391227000542c73042b0bf219 Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Sat, 14 Nov 2026 00:51:04 +0800
Subject: [PATCH] rothko: port hardware/mediatek integration to Android 17

Carry the final 23.2 device integration delta onto the official 24.0 tree.
Old upstream base: 68f9be72a32bca66e7c63d69e9739b18f13c8b48
Recorded device baseline: 43572e2342b9cb9b37f4e3d8dce44d7c8152f15b
New upstream target: 32bd412433ef0d58c3484769d9789987407627fc

Three-way tree integration and whitespace checks passed. Compilation and
24.0 device validation are pending. Historical reverted changes are
represented by their final net effect. The project migration record
LINEAGE_24_MIGRATION_20261114.zh-CN.md tracks companion repository pins.
---
 aidl/thermal/Thermal.cpp        | 30 ++++++++++++++++++++++--------
 aidl/thermal/Thermal.h          |  8 ++++++--
 aidl/thermal/thermal-helper.cpp | 23 ++++++++++++++++++++++-
 aidl/thermal/thermal-helper.h   |  2 +-
 4 files changed, 51 insertions(+), 12 deletions(-)

diff --git a/aidl/thermal/Thermal.cpp b/aidl/thermal/Thermal.cpp
index bd98e46ba491ba7bccef6a55264eddfb45fbec80..2a8276c663a99b4d6412cc813c0b6759cabaa214 100644
--- a/aidl/thermal/Thermal.cpp
+++ b/aidl/thermal/Thermal.cpp
@@ -49,6 +49,12 @@ Thermal::Thermal(const std::shared_ptr<ThermalHelper> &helper) {
     thermal_helper_ = helper;
 }
 
+Thermal::~Thermal() {
+    // Queued snapshots use the helper; watcher callbacks use the subscription state.
+    looper_.stop();
+    thermal_helper_.reset();
+}
+
 ndk::ScopedAStatus Thermal::getTemperatures(std::vector<Temperature> *_aidl_return) {
     return getFilteredTemperatures(false, TemperatureType::UNKNOWN, _aidl_return);
 }
@@ -183,7 +189,8 @@ ndk::ScopedAStatus Thermal::registerThermalChangedCallback(
             std::lock_guard<std::mutex> _lock(thermal_callback_mutex_);
             auto it = std::find_if(callbacks_.begin(), callbacks_.end(),
                                    [&](const CallbackSetting &cc) {
-                                       return interfacesEqual(c.callback, cc.callback);
+                                       return interfacesEqual(c.callback, cc.callback) &&
+                                              c.registration_token == cc.registration_token;
                                    });
             if (it != callbacks_.end()) {
                 if (AIBinder_isAlive(c.callback->asBinder().get())) {
@@ -889,24 +896,31 @@ void Thermal::Looper::addEvent(const Thermal::Looper::Event &e) {
 }
 
 Thermal::Looper::~Looper() {
+    stop();
+}
+
+void Thermal::Looper::stop() {
     {
         std::unique_lock<std::mutex> lock(mutex_);
         aborted_ = true;
     }
     cv_.notify_one();
-    thread_.join();
+    if (thread_.joinable()) {
+        thread_.join();
+    }
 }
 
 void Thermal::Looper::loop() {
-    while (!aborted_) {
+    while (true) {
         std::unique_lock<std::mutex> lock(mutex_);
         cv_.wait(lock, [&] { return aborted_ || !events_.empty(); });
-        if (!aborted_ && !events_.empty()) {
-            Event event = events_.front();
-            events_.pop();
-            lock.unlock();
-            event.handler();
+        if (aborted_) {
+            return;
         }
+        Event event = events_.front();
+        events_.pop();
+        lock.unlock();
+        event.handler();
     }
 }
 
