+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.display.brightness;
+
+import android.content.Context;
+import android.hardware.display.BrightnessInfo;
+import android.os.Handler;
+import android.util.Slog;
+
+import java.io.PrintWriter;
+
+/**
+ * Optional device-owned brightness bounds. No panel values belong in this interface.
+ *
+ * All calls and the change callback run on the display handler. Implementations must keep disk,
+ * sysfs and Binder IO off that handler, expire stale input, and release their workers in stop().
+ * The device system-server jar must expose a (Context, Handler, Runnable) constructor.
+ * @hide
+ */
+public abstract class DeviceBrightnessPolicy {
+    public abstract void setDisplayState(int state);
+    public abstract void setAutomaticBrightness(boolean enabled);
+    public abstract void setAmbientLux(float lux);
+
+    /**
+     * SurfaceFlinger's actual visible HDR-layer classification, including extended-range RGB.
+     * Unknown is distinct from an observed absence. This is not a picture/video classification
+     * and does not itself authorize any brightness boost.
+     */
+    public void setHdrContent(boolean known, boolean present) { }
+
+    /** Finite nonnegative nits cap; positive infinity means no additional cap. Never NaN. */
+    public abstract float getMaxBrightnessNits();
+
+    /**
+     * Optional tighter SDR white-point bound for the same common-cap snapshot. The common
