+    cflags: ["-DROTHKO_LEGACY_CAMERA_WINDOW_HANDLE"],
+    static_libs: [
+        "android.hardware.camera.common-helper_nogralloc",
+        "libaidlcommonsupport",
+        "libarect",
     ],
 }
 
