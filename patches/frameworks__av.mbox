--- a/camera/ndk/ndk_vendor/impl/utils.cpp
+++ b/camera/ndk/ndk_vendor/impl/utils.cpp
@@ -17,6 +17,9 @@
 #define LOG_TAG "ACameraVendorUtils"
 
 #include "utils.h"
+#ifdef ROTHKO_LEGACY_CAMERA_WINDOW_HANDLE
+#include <aidlcommonsupport/NativeHandle.h>
+#endif
 
 #include <utils/Log.h>
 
@@ -137,6 +140,84 @@ camera_status_t convertFromAidl(Status status) {
     return ret;
 }
 
+#ifdef ROTHKO_LEGACY_CAMERA_WINDOW_HANDLE
+bool isWindowNativeHandleEqual(const native_handle_t *nh1, const native_handle_t *nh2) {
+    if (nh1 == nullptr || nh2 == nullptr) return nh1 == nh2;
+    if (nh1->numFds !=0 || nh2->numFds !=0) {
+        ALOGE("Invalid window native handles being compared");
+        return false;
+    }
+    if (nh1->version != nh2->version || nh1->numFds != nh2->numFds ||
+        nh1->numInts != nh2->numInts) {
+        return false;
+    }
+    for (int i = 0; i < nh1->numInts; i++) {
+        if(nh1->data[i] != nh2->data[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool isWindowNativeHandleEqual(const native_handle_t *nh1,
+                               const aidl::android::hardware::common::NativeHandle& nh2) {
+    native_handle_t* tempNh = makeFromAidl(nh2);
+    bool equal = tempNh != nullptr && isWindowNativeHandleEqual(nh1, tempNh);
+    native_handle_delete(tempNh);
+    return equal;
+}
+
+bool isWindowNativeHandleLessThan(const native_handle_t *nh1, const native_handle_t *nh2) {
+    if (nh1 == nullptr || nh2 == nullptr) return nh1 == nullptr && nh2 != nullptr;
+    if (isWindowNativeHandleEqual(nh1, nh2)) {
+        return false;
+    }
+    if (nh1->numInts != nh2->numInts) {
+        return nh1->numInts < nh2->numInts;
+    }
+
+    for (int i = 0; i < nh1->numInts; i++) {
+        if (nh1->data[i] != nh2->data[i]) {
+            return nh1->data[i] < nh2->data[i];
+        }
+    }
+    return false;
+}
+
+bool isWindowNativeHandleGreaterThan(const native_handle_t *nh1, const native_handle_t *nh2) {
+    return !isWindowNativeHandleLessThan(nh1, nh2) && !isWindowNativeHandleEqual(nh1, nh2);
+}
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+void appendOutputWindow(OutputConfiguration& config, ACameraWindowType* window) {
+    config.windowHandles.emplace_back(dupToAidl(window));
+}
+const std::vector<OutputWindow>& getOutputWindows(const OutputConfiguration& config) {
+    return config.windowHandles;
+}
+bool isOutputWindowEqual(ACameraWindowType* window, const OutputWindow& output) {
+    return isWindowNativeHandleEqual(window, output);
+}
+ACameraWindowType* getOutputWindowForCallback(const OutputWindow& output) {
+    return makeFromAidl(output);
+}
+#pragma clang diagnostic pop
+#else
+void appendOutputWindow(OutputConfiguration& config, ACameraWindowType* window) {
+    config.surfaces.emplace_back(window);
+}
+const std::vector<OutputWindow>& getOutputWindows(const OutputConfiguration& config) {
+    return config.surfaces;
+}
+bool isOutputWindowEqual(ACameraWindowType* window, const OutputWindow& output) {
+    return window == output.get();
+}
+ACameraWindowType* getOutputWindowForCallback(const OutputWindow& output) {
+    return output.get();
+}
+#endif
+
 } // namespace utils
 } // namespace acam
 } // namespace android
