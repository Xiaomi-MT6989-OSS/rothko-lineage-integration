From ebf9c8f2b2f80eacf173bed725f9f241d7f48b0a Mon Sep 17 00:00:00 2001
From: tunkoal <tunkoal@163.com>
Date: Sat, 14 Nov 2026 09:00:20 +0800
Subject: [PATCH 2/2] packaging: select filesystem image variants before native
 library linkage

Android 17 generated ODM filesystem depends on libtouchsensor and libtensorflowlite_touch_c, which have both vendor and recovery variants. PackagingBase queried linkage with no image and could not resolve a default alias. Select a supported filesystem image variant first, map ODM to the vendor ABI, and retain the original fallback for deps without that variation. Keep recovery availability and the OEM runtime install contract. Add an ODM/recovery regression fixture. gofmt and whitespace passed. Go test and unified build retry pending.

Change-Id: I88aace98120c0c6e2620ee14f232f826625ba112
---
 android/packaging.go          | 19 +++++++++++++++++++
 filesystem/filesystem_test.go | 19 +++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/android/packaging.go b/android/packaging.go
index 3cbf90b676a4946d8a24a8387934d6afbc64c711..4dd5138e70c625d73e2bd90f7df6011160a35f5c 100644
--- a/android/packaging.go
+++ b/android/packaging.go
@@ -499,6 +499,25 @@ func (p *PackagingBase) AddDeps(ctx BottomUpMutatorContext, depTag blueprint.Dep
 			Variation: "dylib",
 		}
 
+		// A library available in recovery has multiple image variants and may have
+		// no default image alias. Select the filesystem's image before its linkage.
+		if filesystem, ok := ctx.Module().(interface{ PartitionType() string }); ok {
+			image := filesystem.PartitionType()
+			switch image {
+			case "odm":
+				image = VendorVariation
+			case "system", "system_ext":
+				image = CoreVariation
+			}
+			imageVariations := append(t.Variations(), blueprint.Variation{
+				Mutator: "image", Variation: image,
+			})
+			if ctx.OtherModuleDependencyVariantExists(append(imageVariations, sharedVariation), dep) ||
+				ctx.OtherModuleDependencyVariantExists(imageVariations, dep) {
+				targetVariation = imageVariations
+			}
+		}
+
 		// If a shared variation exists, use that. Static variants do not provide any standalone files
 		// for packaging. Similarly, use the dylib variation of rust library if it exists as
 		// the static lib (rlib) variants are never installed.
diff --git a/filesystem/filesystem_test.go b/filesystem/filesystem_test.go
index 596d1313f203ac902bb5d5fb6e0b2d05e54bdd96..1a5d5601064949d776189452fe379ece279c620d 100644
--- a/filesystem/filesystem_test.go
+++ b/filesystem/filesystem_test.go
@@ -986,3 +986,22 @@ android_device {
 	mkBootimgCmd := vendorBootImg.Rule("target_files_dir").RuleParams.Command
 	android.AssertStringDoesContain(t, "Did not find dlkm in vendor_ramdisk_fragments file used for target_files.zip creation", mkBootimgCmd, "echo dlkm > out/soong/.intermediates/test_device/android_arm64_armv8-a/target_files_dir/VENDOR_BOOT/vendor_ramdisk_fragments")
 }
+
+func TestNativeLibraryWithRecoveryVariantInOdmFilesystem(t *testing.T) {
+	t.Parallel()
+	result := fixture.RunTestWithBp(t, `
+		android_filesystem {
+			name: "touch_odm_filesystem",
+			partition_type: "odm",
+			deps: ["libtouch"],
+		}
+		cc_library_shared {
+			name: "libtouch",
+			device_specific: true,
+			recovery_available: true,
+		}
+	`)
+	partition := result.ModuleForTests(t, "touch_odm_filesystem", "android_common")
+	fileList := android.ContentFromFileRuleForTests(t, result.TestContext, partition.Output("fileList"))
+	android.AssertStringDoesContain(t, "ODM image must include its shared library", fileList, "lib64/libtouch.so")
+}
